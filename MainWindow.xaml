<Window
    x:Class="GolfStatistics.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GolfStatistics">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="2016 workbook - SheetInfo!B1"
            FontSize="18"
            FontWeight="SemiBold" />

        <TextBox
            x:Name="CellValueTextBox"
            Grid.Row="1"
            AcceptsReturn="True"
            IsReadOnly="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <Button
            x:Name="RetrieveButton"
            Grid.Row="2"
            HorizontalAlignment="Left"
            Click="RetrieveButton_Click"
            Content="Retrieve from Google" />

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="3"
            TextWrapping="Wrap" />
    </Grid>
</Window>
